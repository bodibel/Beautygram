# Copy this file to .env on the VPS host before running docker compose.
# Replace every placeholder value with a real production value.

# Database / Postgres container
POSTGRES_USER="glowyspot_user"
POSTGRES_PASSWORD="replace-with-a-strong-db-password"
POSTGRES_DB="glowyspot"

# Application database connection
DATABASE_URL="postgresql://glowyspot_user:replace-with-a-strong-db-password@glowyspot-db:5432/glowyspot?schema=public"

# NextAuth / public domain
NEXTAUTH_URL="https://your-domain.example"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# OAuth
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Public frontend API keys
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-google-maps-browser-key"

# Backend integrations
OPENAI_API_KEY="replace-with-openai-api-key"
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="noreply@your-domain.example"

# Internal protection
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Upload root inside the container
# docker-compose.vps.yml mounts ./public/uploads -> /app/public/uploads
UPLOAD_DIR="/app/public"
