{
  "name": "glowyspot",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3020",
    "dev:lowmem": "set NODE_OPTIONS=--max-old-space-size=1024&& next dev --webpack --disable-source-maps -p 3020",
    "build": "next build --webpack",
    "start": "next start -p 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke:e2e": "playwright test",
    "e2e:seed": "tsx tests/e2e/setup/seed-mvp.ts",
    "e2e:mvp": "npm run e2e:seed && playwright test tests/e2e/glowyspot-mvp-flows.e2e.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-google-maps/api": "^2.20.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.554.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.13",
    "openai": "^6.32.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "use-places-autocomplete": "^4.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
