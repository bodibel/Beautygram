# Database
DATABASE_URL="postgresql://glowyspot_user:YOUR_DB_PASSWORD@glowyspot-db:5432/glowyspot?schema=public"
POSTGRES_USER=glowyspot_user
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=glowyspot

# NextAuth
NEXTAUTH_URL="https://glowyspot.com"
NEXTAUTH_SECRET="your-secret-here"

# App
NEXT_PUBLIC_APP_DOMAIN="glowyspot.com"

# External APIs
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"
GEMINI_API_KEY="your-gemini-key"
RESEND_API_KEY="your-resend-key"
EMAIL_FROM="noreply@mail.glowyspot.com"

# Google Auth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# File uploads (set to /app/public for Docker, leave unset for local dev)
UPLOAD_DIR=/app/public
