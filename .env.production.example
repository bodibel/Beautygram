# ─── Database ─────────────────────────────────────────────────────────────────
# A DB_PORT csak a docker-compose host-oldali portmappinghez kell (alapértelmezés: 5410).
DB_PORT=5410
DATABASE_URL="postgresql://glowyspot_user:YOUR_DB_PASSWORD@glowyspot-db:5432/glowyspot?schema=public"
POSTGRES_USER=glowyspot_user
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=glowyspot

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET generálása: openssl rand -base64 32
NEXTAUTH_URL="https://glowyspot.com"
NEXTAUTH_SECRET="your-secret-here"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN="glowyspot.com"

# ─── Cron védelem (KÖTELEZŐ) ──────────────────────────────────────────────────
# A /api/cron/* végpontok fail-closed módon működnek: ha ez a változó hiányzik,
# minden hívás 401-et kap, és az ütemezett feladatok NEM futnak le.
# Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Használat:
#   0 3 * * * curl -H "Authorization: Bearer $CRON_SECRET" https://glowyspot.com/api/cron/expire-free-salons
#   0 4 * * * curl -H "Authorization: Bearer $CRON_SECRET" https://glowyspot.com/api/cron/enforce-publishing-quota
#   0 9 * * * curl -H "Authorization: Bearer $CRON_SECRET" https://glowyspot.com/api/cron/subscription-reminders
CRON_SECRET="your-cron-secret-here"

# ─── External APIs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"
GEMINI_API_KEY="your-gemini-key"
# Az OPENAI_API_KEY a feltöltött képek moderálásához kell. A moderáció fail-closed:
# hiányzó kulcs esetén a képfeltöltés elutasításra kerül.
OPENAI_API_KEY="your-openai-api-key"
RESEND_API_KEY="your-resend-key"
EMAIL_FROM="noreply@mail.glowyspot.com"

# ─── Google Auth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── File uploads ─────────────────────────────────────────────────────────────
# Docker esetén /app/public, lokális fejlesztésnél hagyd üresen.
UPLOAD_DIR=/app/public
