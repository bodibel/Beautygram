# App / auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Database
DATABASE_URL="postgresql://glowyspot_user:replace-with-db-password@localhost:5432/glowyspot?schema=public"
POSTGRES_USER="glowyspot_user"
POSTGRES_PASSWORD="replace-with-db-password"
POSTGRES_DB="glowyspot"
DB_PORT="5434"

# OAuth
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Public frontend API keys
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-google-maps-browser-key"

# Backend integrations
OPENAI_API_KEY="replace-with-openai-api-key"
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="noreply@example.com"

# Internal protection
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional local upload root
# Leave unset in local dev to use ./public/uploads
# Set to /app/public in Docker/VPS setups that mount ./public/uploads there
UPLOAD_DIR=""
